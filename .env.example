# Copy this file to .env and fill it in.

# Folders holding your logins (usually inside the home folder of the user
# who ran "claude" and "codex login"). Run `ls -a ~` on the server to check.
CLAUDE_HOME=/home/yourname/.claude
CODEX_HOME=/home/yourname/.codex

# The user/group that owns those folders. Find them with: id -u  and  id -g
PUID=1000
PGID=1000

# Port the dashboard is served on.
PORT=8787

# Optional but recommended: browser will ask for this (any username works).
DASHBOARD_PASSWORD=

# How often (seconds) to ask Anthropic/OpenAI for fresh numbers. Minimum 30.
REFRESH_SECONDS=60

# Let the dashboard renew expired logins itself. Set to false if you'd rather
# it only ever reads them (it will then show "expired" until you use the CLI).
ALLOW_TOKEN_REFRESH=true
